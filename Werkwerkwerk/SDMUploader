function testColumns() {
  try {
    const sheet = SpreadsheetApp.getActiveSpreadsheet().getActiveSheet();
    const headers = sheet.getDataRange().getValues()[0];
    
    const requiredColumns = [
      "Subscriber Name", "Branch", "Sales Remarks", "Account Number", 
      "Jo Number", "JO Created", "POI", "Target RFS Date", "NAP Assignment", 
      "Status", "Work Item"
    ];
    
    let results = "Column Analysis:\n\n";
    
    requiredColumns.forEach(column => {
      const index = headers.indexOf(column);
      if (index !== -1) {
        results += `✅ ${column}: Column ${index + 1}\n`;
      } else {
        results += `❌ ${column}: NOT FOUND\n`;
      }
    });
    
    console.log(results);
    SpreadsheetApp.getActive().toast('Column analysis complete. Check logs.', "Test Columns", 5);
    
  } catch (error) {
    console.error("Test Columns error:", error);
    SpreadsheetApp.getActive().toast('Error testing columns. Check logs.', "Error", 5);
  }
}


