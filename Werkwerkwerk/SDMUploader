function identifyUserPickerField() {
  const scriptProps = PropertiesService.getScriptProperties();
  const email = scriptProps.getProperty("JIRA_EMAIL");
  const apiToken = scriptProps.getProperty("JIRA_TOKEN");
  const jiraDomain = "https://convergeict-sandbox-467.atlassian.net";

  const options = {
    method: "get",
    headers: {
      Authorization: "Basic " + Utilities.base64Encode(email + ":" + apiToken),
      Accept: "application/json"
    },
    muteHttpExceptions: true
  };

  // Get request type fields configuration
  const url = `${jiraDomain}/rest/servicedeskapi/servicedesk/630/requesttype/1060/field`;
  const response = UrlFetchApp.fetch(url, options);
  const code = response.getResponseCode();
  const responseText = response.getContentText();

  console.log(`Fields API Response Code: ${code}`);
  
  if (code === 200) {
    const fieldsData = JSON.parse(responseText);
    console.log('=== CHECKING FOR USER PICKER FIELDS ===');
    
    let foundUserPicker = false;
    
    fieldsData.requestTypeFields.forEach(field => {
      const isUserPicker = field.jiraSchema && 
                          (field.jiraSchema.type === 'user' || 
                           field.jiraSchema.type === 'array' && field.jiraSchema.items === 'user');
      
      if (isUserPicker) {
        foundUserPicker = true;
        console.log(`🚨 USER PICKER FOUND: ${field.fieldId} (${field.name})`);
        console.log(`   Required: ${field.required}`);
        console.log(`   Type: ${field.fieldType}`);
        console.log(`   Schema: ${JSON.stringify(field.jiraSchema)}`);
      }
    });
    
    if (!foundUserPicker) {
      console.log('No user picker fields found in configuration');
      
      // List all fields for reference
      console.log('\n=== ALL FIELDS ===');
      fieldsData.requestTypeFields.forEach(field => {
        console.log(`${field.fieldId}: ${field.name} (${field.fieldType}) - Required: ${field.required}`);
      });
    }
  } else {
    console.log('Failed to get field configuration:', responseText);
  }
}