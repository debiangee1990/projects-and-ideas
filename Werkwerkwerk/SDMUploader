        if (code === 201) {
          const resData = JSON.parse(responseText);
          const issueKey = resData.issueKey || resData.key || "N/A";

          sheet.getRange(i + 1, statusCol + 1).setValue("Pass");
          sheet.getRange(i + 1, workItemCol + 1).setValue(issueKey);
          successCount++;
          console.log(`✅ Created Jira issue: ${issueKey}`);
        } else {
          errorCount++;
          let errorDetail = "Unknown error";
          try {
            const errorData = JSON.parse(responseText);
            errorDetail = errorData.message || JSON.stringify(errorData.errors || errorData, null, 2);
          } catch (e) {
            errorDetail = responseText.substring(0, 500);
          }
          
          console.error(`❌ API Error ${code}:`, errorDetail);
          
          let userMessage = `Fail (${code})`;
          if (code === 401) userMessage = "Fail: Authentication Error";
          else if (code === 403) userMessage = "Fail: Permission Denied";
          else if (code === 404) userMessage = "Fail: Service Desk Not Found";
          else if (code === 429) userMessage = "Fail: Rate Limit Exceeded";
          
          sheet.getRange(i + 1, statusCol + 1).setValue(userMessage);
          sheet.getRange(i + 1, workItemCol + 1).setValue(errorDetail.substring(0, 100));
        }


        try {
          const response = UrlFetchApp.fetch(url, options);
