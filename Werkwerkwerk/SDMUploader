  function formatDate_(value) {
    const DEFAULT_DATE = "1970-12-31";

    if (!value) return DEFAULT_DATE;
    try {
      // If it's already a Date object
      if (value instanceof Date) {
        if (isNaN(value.getTime())) return DEFAULT_DATE;
        return Utilities.formatDate(value, Session.getScriptTimeZone(), "yyyy-MM-dd");
      }

      // If it's a string in mm/dd/yyyy format
      const dateString = String(value).trim();
      if (dateString.match(/^\d{1,2}\/\d{1,2}\/\d{4}$/)) {
        const [month, day, year] = dateString.split('/').map(Number);
        const date = new Date(year, month - 1, day); // month is 0-indexed in JavaScript
        if (isNaN(date.getTime())) return DEFAULT_DATE;
        return Utilities.formatDate(date, Session.getScriptTimeZone(), "yyyy-MM-dd");
      }

      // For other date formats, let JavaScript handle it
      const date = new Date(value);
      if (isNaN(date.getTime())) return DEFAULT_DATE;
      return Utilities.formatDate(date, Session.getScriptTimeZone(), "yyyy-MM-dd");

    } catch (e) {
      console.warn("Invalid date value:", value, e.toString());
      return DEFAULT_DATE;
    }
  }

