function doPost(e) {
  try {
    // Parse the incoming payload (fake Jira data for now)
    var data = JSON.parse(e.postData.contents);

    // Construct the payload for AppSheet
    var payload = {
      "Action": "Add",
      "Rows": [data]
    };

    // AppSheet API configuration
    var props = PropertiesService.getScriptProperties();
    var appId = props.getProperty("APP_ID");
    var tableName = props.getProperty("TABLE_NAME");
    var apiKey = props.getProperty("API_KEY");

    Logger.log("App ID: " + appId + " | Table: " + tableName + " | Key: " + apiKey);

    var url = `https://api.appsheet.com/api/v2/apps/${appId}/tables/${tableName}/Action`;

    var options = {
      "method": "post",
      "contentType": "application/json",
      "headers": { "ApplicationAccessKey": apiKey },
      "payload": JSON.stringify(payload),
      "muteHttpExceptions": true
    };

    // Send the data to AppSheet
    var response = UrlFetchApp.fetch(url, options);
    Logger.log(response.getContentText());
    Logger.log("Response Code: " + response.getResponseCode());
    Logger.log("Response Text: " + response.getContentText());
    Logger.log("Payload sent: " + JSON.stringify(payload));

    return ContentService.createTextOutput("Success: " + response.getContentText())
      .setMimeType(ContentService.MimeType.TEXT);
  } catch (error) {
    Logger.log(error);
    return ContentService.createTextOutput("Error: " + error)
      .setMimeType(ContentService.MimeType.TEXT);
  }
}

